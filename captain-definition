{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:lts-alpine",
    "WORKDIR /app",
    "COPY package.json yarn.lock ./",
    "RUN npm install --frozen-lockfile",
    "COPY . .",
    "RUN npm run build",
    "EXPOSE 9000",
    "ENV MEDUSA_WORKER_MODE=server",
    "CMD [\"npm\", \"run\", \"start\"]"
  ]
}
