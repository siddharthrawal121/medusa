{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:lts-alpine",
    "WORKDIR /app",
    "COPY my-medusa-store/package.json my-medusa-store/package-lock.json ./",
    "RUN npm install --frozen-lockfile",
    "COPY my-medusa-store/ .",
    "RUN npm run build && mkdir -p public/admin && cp -r ./.medusa/admin/build/* ./public/admin/",
    "EXPOSE 9000",
    "ENV MEDUSA_WORKER_MODE=server",
    "CMD [\"npm\", \"run\", \"start\"]"
  ]
}
