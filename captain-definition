// captain-definition
{
  "schemaVersion" : 2,
  "dockerfileLines" : [
    "FROM node:lts-alpine",
    "WORKDIR /app",

    "# Install dependencies",
    "COPY my-medusa-store/package.json my-medusa-store/package-lock.json ./",
    "RUN npm install --frozen-lockfile",

    "# Copy code + config",
    "COPY my-medusa-store/ .",

    "# Build Medusa + Admin UI → then copy admin into public/admin",
    "RUN npm run build \\",
    "  && mkdir -p public/admin \\",
    "  && cp -r ./.medosa/admin/build/* ./public/admin/",

    "# Expose & run",
    "EXPOSE 9000",
    "ENV MEDUSA_WORKER_MODE=server",
    "CMD [\"npm\", \"run\", \"start\"]"
  ]
}
